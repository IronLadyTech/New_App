{
  "expo": {
    "name": "Iron Lady",
    "slug": "lms-app",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "lmsapp",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ironlady.app"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "backgroundColor": "#ED1D24",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.ironlady.app",
      "versionCode": 4,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-secure-store",
      "expo-video",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Iron Lady to record your Power Pitch."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#ED1D24",
          "defaultChannel": "default"
        }
      ],
      "./plugins/withIronLadyNotificationBrand.js",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Iron Lady to use a photo for your profile."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ED1D24",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "105ad21e-a20b-4925-8fd3-221ed9706bbe"
      }
    }
  }
}
