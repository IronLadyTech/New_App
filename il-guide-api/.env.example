# Required for LLM generation (falls back to rules if unset)
OPENAI_API_KEY=

# Optional — defaults shown
OPENAI_MODEL=gpt-4o-mini
IL_GUIDE_API_KEY=

# Optional Redis for cross-request nudge rotation
REDIS_URL=redis://localhost:6379/0

# Optional ChromaDB path for curriculum RAG (LEP / 100BM / MC)
CHROMA_PERSIST_DIR=
CHROMA_COLLECTION=iron_lady_curriculum

# Server (Render injects PORT automatically)
HOST=0.0.0.0
PORT=8080
CORS_ORIGINS=*

# WhatsApp Cloud API OTP (Meta Business > WhatsApp > API Setup)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
# Approved template of category AUTHENTICATION with a "Copy code" button
WHATSAPP_OTP_TEMPLATE=login_otp
WHATSAPP_OTP_LANGUAGE=en
# Firebase console > Project settings > Service accounts > Generate key; paste the JSON on one line
FIREBASE_SERVICE_ACCOUNT_JSON=

# --- After Render deploy ---
# Service URL example: https://il-guide-api.onrender.com
# In the Expo app (.env):
#   EXPO_PUBLIC_IL_GUIDE_API_URL=https://il-guide-api.onrender.com
#   EXPO_PUBLIC_IL_GUIDE_API_KEY=<same as IL_GUIDE_API_KEY on Render>
#   EXPO_PUBLIC_WHATSAPP_OTP=true   (switches phone login from demo codes to WhatsApp)
