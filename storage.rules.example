rules_version = '2';
// Prefer deploying storage.rules (copied from new_lms + CMS).
// Program folders: mbw/, bm100/, lep/, cms/
service firebase.storage {
  match /b/{bucket}/o {
    function role() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    // MBW learner uploads
    match /mbw/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || role() in ['moderator', 'admin', 'superadmin']);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 100BM learner uploads
    match /bm100/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || role() in ['moderator', 'admin', 'superadmin']);
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // LEP learner uploads (video up to 200MB; other files up to 15MB)
    match /lep/{userId}/{taskId}/video/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || role() in ['moderator', 'admin', 'superadmin']);
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (request.resource == null || request.resource.size < 200 * 1024 * 1024);
    }
    match /lep/{userId}/{allPaths=**} {
      allow read: if request.auth != null && (request.auth.uid == userId || role() in ['moderator', 'admin', 'superadmin']);
      allow write: if request.auth != null
        && request.auth.uid == userId
        && (request.resource == null || request.resource.size < 15 * 1024 * 1024);
    }

    // Admin CMS uploads: anyone signed in can read, PL/Admin upload (max 500 MB).
    match /cms/{program}/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && role() in ['admin', 'superadmin', 'pl']
        && (request.resource == null || request.resource.size < 500 * 1024 * 1024);
    }
  }
}
