    "@react-navigation/bottom-tabs": "^7.19.2",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.2",
    "babel-preset-expo": "~58.0.0",
    "expo": "^58.0.19",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-blur": "~58.0.5",
    "expo-constants": "~58.0.13",
    "expo-dev-client": "~58.0.17",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.4",
    "expo-firebase-recaptcha": "~2.3.1",
    "expo-font": "~58.0.10",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.3",
    "expo-linking": "~58.0.14",
    "expo-notifications": "~58.1.6",
    "expo-screen-orientation": "~58.0.3",
    "expo-secure-store": "~58.0.2",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-updates": "~58.0.19",
    "expo-video": "~58.0.12",
    "firebase": "^12.19.0",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "react-native-svg": "15.16.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "^0.21.4",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "^3.4.17"
  },
  "scripts": {
    "start": "expo start",
    "start:reset": "expo start -c",
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { . ./scripts/android-build-env.ps1; npx expo run:android }\"",
    "android:use-d": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/migrate-android-to-d.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "export:web": "expo export --platform web",
    "deploy:web": "expo export --platform web && node scripts/copy-push-brand.js && firebase deploy --only hosting --project lmsironlady",
    "verify:android-notifications": "node scripts/verify-notification-android.js",
    "build:apk": "node scripts/verify-notification-android.js && npx eas-cli build -p android --profile preview",
    "build:apk:local": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-release-apk-local.ps1",
    "build:apk:wsl": "wsl bash /mnt/d/app-new/scripts/build-release-apk-wsl.sh",
    "android:prebuild": "expo prebuild --platform android --no-install",
    "android:dev": "expo run:android",
    "android:dev:phone": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { . ./scripts/android-build-env.ps1; $env:ORG_GRADLE_PROJECT_reactNativeArchitectures='arm64-v8a'; npx expo run:android -d }\"",
    "android:phone": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/wait-android-phone-and-run.ps1",
    "start:web": "expo start --web",
    "postinstall": "patch-package",
    "ota": "node scripts/ota.js",
    "dev:phone": "expo start --dev-client",
    "build:apk:fast": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build-apk-fast.ps1"
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "patch-package": "^8.0.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~6.0.3"
  }
}
