# Copy to .env for local / staging Expo builds.
# Never commit real tokens.

# IL Guide + WhatsApp OTP API (Render)
EXPO_PUBLIC_IL_GUIDE_API_URL=https://YOUR-il-guide-api.onrender.com
EXPO_PUBLIC_IL_GUIDE_API_KEY=
# true = real WhatsApp codes; unset/false = demo OTP on phone login
EXPO_PUBLIC_WHATSAPP_OTP=false

# Optional — phone OTP channel: firebase | whatsapp | demo (web defaults to demo for local preview)
# EXPO_PUBLIC_PHONE_OTP=firebase
# EXPO_PUBLIC_IL_GUIDE_USE_FIREBASE=true

# Screen lab / demo flow bar on a physical device (default: web Metro only)
# EXPO_PUBLIC_ENABLE_DEV_TOOLS=true

# Android tray push (APK): download google-services.json from Firebase Console
# (project lmsironlady, package com.ironlady.app) → save as ./google-services.json
# and set in app.json: android.googleServicesFile — then rebuild APK with EAS.
#
# Phone SMS OTP (production APK): Firebase Console → Authentication → Sign-in method → Phone → Enable.
# Also add your Android SHA-1 (EAS credentials / Play App Signing) under Project settings → Your apps → Android.
# Native Android/iOS use @react-native-firebase/auth (SMS without reCAPTCHA modal); android/build.gradle pins Firebase BOM for Expo Kotlin 2.2.
