# Copy to .env for local / staging Expo builds.
# Never commit real tokens.

# IL Guide + WhatsApp OTP API (Render)
EXPO_PUBLIC_IL_GUIDE_API_URL=https://YOUR-il-guide-api.onrender.com
EXPO_PUBLIC_IL_GUIDE_API_KEY=
# true = real WhatsApp codes; unset/false = demo OTP on phone login
EXPO_PUBLIC_WHATSAPP_OTP=false

# Optional — use Firebase Cloud Function for IL Guide instead of Render
# EXPO_PUBLIC_IL_GUIDE_USE_FIREBASE=true

# Android tray push (APK): download google-services.json from Firebase Console
# (project lmsironlady, package com.ironlady.app) → save as ./google-services.json
# and set in app.json: android.googleServicesFile — then rebuild APK with EAS.
